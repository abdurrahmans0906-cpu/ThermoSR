PROJECT_NAME=ThermoSR
VERSION=1.0.0
API_V1_STR=/api

# Database: SQLite by default for zero-config local run, or PostgreSQL
DATABASE_URL=sqlite+aiosqlite:///thermosr.db
DATABASE_SYNC_URL=sqlite:///thermosr.db
# For PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://thermosr:thermosr_password@localhost:5432/thermosr_db
# DATABASE_SYNC_URL=postgresql://thermosr:thermosr_password@localhost:5432/thermosr_db

# Default dataset location
DATASET_ROOT_DEFAULT=c:\Users\abdur\Downloads\challengedataset - Copy\challengedataset

# Security & Uploads
MAX_UPLOAD_SIZE_MB=50
